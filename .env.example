# Kabai UI - environment variables
# Copy this file to .env and adjust the values

# ── Development (npm run dev) ─────────────────────────────────────────────────
# PostgreSQL connection (required)
KABAI_DB_HOST=localhost
KABAI_DB_PORT=5432
KABAI_DB_NAME=kabai

# Session configuration (required)
KABAI_SESSION_SECRET=generate-a-random-secret-here
KABAI_SESSION_TTL_MINUTES=480

# HTTP port of the app (optional, default: 3000)
PORT=3000

# Without this, @sveltejs/adapter-node GUESSES its own origin as
# "https://<Host header>" — even when the app is plain HTTP with no
# reverse proxy in front. If you access kabai-ui over http:// (e.g. a
# VPN-internal hostname without TLS), that guess is wrong and SvelteKit's
# CSRF check rejects file-upload POSTs (e.g. ticket attachments) with
# HTTP 403. Set this to exactly the URL you type in the browser
# (scheme + host + port):
# ORIGIN=http://kabai.example.com:3000

# Node.js environment
NODE_ENV=development

# ── Docker Compose (additionally required) ───────────────────────────────────
# PostgreSQL user and password for the Docker container.
# These are also the credentials you log in with in the browser.
KABAI_DB_USER=kb_user
KABAI_DB_PASSWORD=change_me_in_production

# Random key for session signing — change it!
# Generate with: openssl rand -hex 32
KABAI_SESSION_SECRET=change_me_in_production

# Port the app is exposed on (Docker)
KABAI_PORT=3000
