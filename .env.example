# kbai-ui - Umgebungsvariablen
# Kopiere diese Datei zu .env und passe die Werte an

# ── Entwicklung (npm run dev) ─────────────────────────────────────────────────
# PostgreSQL Verbindung (Pflicht)
KBAI_DB_HOST=localhost
KBAI_DB_PORT=5432
KBAI_DB_NAME=kb_ai

# Session Konfiguration (Pflicht)
KBAI_SESSION_SECRET=generate-a-random-secret-here
KBAI_SESSION_TTL_MINUTES=480

# HTTP Port der App (Optional, Default: 3000)
PORT=3000

# Node.js Umgebung
NODE_ENV=development

# ── Docker Compose (zusätzlich benötigt) ─────────────────────────────────────
# PostgreSQL-Benutzer und Passwort für den Docker-Container
# Mit diesen Credentials meldet man sich im Browser an.
KBAI_DB_USER=kb_user
KBAI_DB_PASSWORD=change_me_in_production

# Zufälliger Schlüssel zur Session-Signierung — unbedingt ändern!
# Erzeugen: openssl rand -hex 32
KBAI_SESSION_SECRET=change_me_in_production

# Port, auf dem die App nach außen erreichbar ist (Docker)
KBAI_PORT=3000
